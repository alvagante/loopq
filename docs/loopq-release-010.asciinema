[0.394, "o", "\r\n"]
[0.082, "o", "\u001b[36m╭─────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1mloopq\u001b[0m  Local fragment queue with review and integration \u001b[36m│\u001b[0m\r\n\u001b[36m╰─────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;36mUsage\u001b[0m  loopq [--loop NAME | --config FILE] COMMAND [OPTIONS]\r\n"]
[0.000, "o", "       loopq help [COMMAND]   or   loopq -h\r\n"]
[0.000, "o", "       Views cover all loops by default; --loop NAME selects one.\r\n"]
[0.000, "o", "       Runs are limited to 30 rows; use --loop for detailed why output.\r\n"]
[0.000, "o", "\u001b[1mYour work\u001b[0m \u001b[92m──────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[0.000, "o", "\u001b[36mdoctor                     \u001b[0m\u001b[36m  \u001b[0mShow blockers and items needing attention; exit 1 if any.    \r\n\u001b[36mtodo                       \u001b[0m\u001b[36m  \u001b[0mShow actionable human steps, waiting steps and unread briefs.\r\n\u001b[36mresolve ID --done|--requeue\u001b[0m\u001b[36m  \u001b[0mClose or return a human item.                                \r\n\u001b[36mack MILESTONE              \u001b[0m\u001b[36m  \u001b[0mMark a milestone brief read and release its hold.            \r\n"]
[0.000, "o", "\u001b[1mInspect\u001b[0m \u001b[92m────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[0.001, "o", "\u001b[36mhelp [COMMAND]             \u001b[0m\u001b[36m  \u001b[0mShow the overview or detailed command help.            \r\n\u001b[36mloops                      \u001b[0m\u001b[36m  \u001b[0mList discovered loops and config paths.                \r\n\u001b[36mstatus                     \u001b[0m\u001b[36m  \u001b[0mShow queue counts, claims, human items and cooldowns.  \r\n\u001b[36mmilestones                 \u001b[0m\u001b[36m  \u001b[0mShow progress and dependencies by milestone.           \r\n\u001b[36mshow ID                    \u001b[0m\u001b[36m  \u001b[0mShow a fragment, its dependencies, commits and history.\r\n\u001b[36mhistory ID                 \u001b[0m\u001b[36m  \u001b[0mShow every recorded transition of a fragment.          \r\n\u001b[36mwhy AGENT                  \u001b[0m\u001b[36m  \u001b[0mExplain why an agent is not taking work.               \r\n\u001b[36mruns [--agent A] [--failed]\u001b[0m\u001b[36m  \u001b[0mList agent sessions and outcomes.                      \r\n\u001b[36msession ID [--paths]       \u001b[0m\u001b[36m  \u001b[0mShow session output or transcript paths.               \r\n"]
[0.000, "o", "\u001b[1mRun the loop\u001b[0m \u001b[92m───────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[0.001, "o", "\u001b[36madd FILE                 \u001b[0m\u001b[36m  \u001b[0mEnqueue a fragment from a Markdown file.              \r\n\u001b[36mtick --agent A [--manual]\u001b[0m\u001b[36m  \u001b[0mCollect a result and reserve the next fragment.       \r\n\u001b[36mrun --agent A            \u001b[0m\u001b[36m  \u001b[0mTick, launch the agent command and collect its result.\r\n\u001b[36mdispatch [--dry-run]     \u001b[0m\u001b[36m  \u001b[0mDrive scheduled agents across all loops.              \r\n\u001b[36mrelease ID               \u001b[0m\u001b[36m  \u001b[0mRelease a claim while keeping partial work.           \r\n\u001b[36mretry ID [--tier T]      \u001b[0m\u001b[36m  \u001b[0mReturn blocked work to the ready queue.               \r\n\u001b[36mpause                    \u001b[0m\u001b[36m  \u001b[0mStop new claims while still collecting results.       \r\n\u001b[36mresume                   \u001b[0m\u001b[36m  \u001b[0mAllow new claims again.                               \r\n\u001b[36mcooldown --agent A       \u001b[0m\u001b[36m  \u001b[0mShow, set or clear an agent cooldown.                 \r\n"]
[0.000, "o", "\u001b[1mSelection and help\u001b[0m \u001b[92m─────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[0.000, "o", "\u001b[36m--loop NAME     \u001b[0m\u001b[36m  \u001b[0mSelect a project listed by `loopq loops`.                                  \r\n\u001b[36m--config FILE   \u001b[0m\u001b[36m  \u001b[0mUse one explicit YAML config; LOOPQ_CONFIG also works.                     \r\n\u001b[36m--config-dir DIR\u001b[0m\u001b[36m  \u001b[0mDiscover configs here; default ~/.config/loopq/loops.d or LOOPQ_CONFIG_DIR.\r\n\u001b[36m-h, --help      \u001b[0m\u001b[36m  \u001b[0mShow help; use `loopq help COMMAND` for command options.                   \r\n"]
[0.009, "o", "bash-3.2$ "]
