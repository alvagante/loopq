[0.000, "o", "e-3          \u001b[0m   \u001b[90m────────────      \u001b[0m                                       \r\n\u001b[1mslice-5   \u001b[0m   \u001b[33min progress                 \u001b[0m   \u001b[32m███\u001b[0m\u001b[90m░░░░░░░░░\u001b[0m 6/21    \u001b[36mready 12\u001b[0m  \u001b[33mclaimed 1\u001b[0m  \u001b[1;31mhuman 2\u001b[0m  \u001b[32mdone 6\u001b[0m\r\n\u001b[1mslice-6   \u001b[0m   \u001b[90mwaiting on slice-1          \u001b[0m   \u001b[90m────────────      \u001b[0m                                       \r\n\u001b[1mslice-7   \u001b[0m   \u001b[33min progress                 \u001b[0m   \u001b[32m███\u001b[0m\u001b[90m░░░░░░░░░\u001b[0m 3/11    \u001b[36mready 7\u001b[0m  \u001b[35mreview 1\u001b[0m  \u001b[32mdone 3\u001b[0m           \r\n\u001b[1mslice-8   \u001b[0m   \u001b[90mwaiting on slice-4, slice-5 \u001b[0m   \u001b[90m────────────      \u001b[0m                                       \r\n\u001b[1mslice-9   \u001b[0m   \u001b[90mwaiting on slice-8          \u001b[0m   \u001b[90m────────────      \u001b[0m                                       \r\n\u001b[1mslice-10  \u001b[0m   \u001b[90mwaiting on slice-5          \u001b[0m   \u001b[9"]
