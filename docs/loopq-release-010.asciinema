[0.789, "o", "\b\b\b\b\b\bp-0014"]
[6.088, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\u001b[8Ptodo"]
[3.328, "o", "\b\u001b[K"]
[0.230, "o", "\b\u001b[K"]
